@{
    ViewBag.Title = "Index";
    Layout = "_Layout";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD" crossorigin="anonymous">


<table class="table table-hover border shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Name</th>
            <th>Gender</th> <th>Topic</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody class="align-middle">
        @foreach (var item in ViewBag.internData)
        {
            <tr>
                <td>@item.c_InternId</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="~/intern_images/@item.ImagePath" width="50" height="50" class="rounded-circle border"
                             style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded-circle border text-center"
                             style="width: 50px; height: 50px; line-height: 50px;">No Img</div>
                    }
                </td>
                <td class="fw-bold">@item.c_InternName</td>
                
                <td>
                    @if (item.c_Gender == "M")
                    {
                        <span class="text-secondary"> Male</span>
                    }
                    else if (item.c_Gender == "F")
                    {
                        <span  class="text-secondary"> Female</span>
                    }
                    else
                    {
                        <span class="text-muted">@item.c_Gender</span>
                    }
                </td>

                <td><span class="badge bg-info text-dark">@item.c_TopicName</span></td>
                <td>@item.c_PresentationDate.ToString("dd MMM yyyy")</td>
                <td>
                    @if (item.c_IsPresented)
                    {
                        <span class="badge bg-success">Presented</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
                <td>
                    <a class="btn btn-sm btn-primary px-3 edit" asp-action="UpdateInternData" asp-route-id="@item.c_InternId"> <i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-danger px-3 delete" asp-action="DeleteIntern" asp-route-id="@item.c_InternId"> <i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {

    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $("#alertMessage").fadeOut("slow");
            }, 3000);
        });
    </script>
}